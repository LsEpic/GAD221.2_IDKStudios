MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 434276334}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6be505acb59422440a288cd8c4be4546, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  journalEntries:
  - 'Journal Entry, Day 1: It is time i voyage home, i hope i can do this without
    you. This ship was yours, i hope to fly it as well as you did.'
  - 'Journal Entry, Day 17: Ive reached Zerak-4 and am back on my journey to take
    you home. Im still so unsure how to do all of this alone, i wish you were here...'
  - "Journal Entry, Day 36: Each step closer to home i feel myself dreading what
    comes. The ships controls are alot to take in, i hope i can follow through on
    my promise.\t"
  - 'Journal Entry, Day 63: My final stop before home, I think youd be proud of me.
    ive learnt so much about the ship and know i can do this.'
  - 'Journal Entry, Day 81: I scattered your ashes over the mountain that we used
    to stare at near home. As the wind carried them away i felt you with me. Just
    because i miss you, doesnt mean i need to stop moving forward. Thankyou for bringing
    me home.'
  journalIndex: 0
